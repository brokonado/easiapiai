{
  "description": "easiapiai: ask once whether to share LLM API usage numbers, and send them about once a week when the user agreed. Nothing happens without Node.js.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/js/easiapiai.mjs\" hook session-start 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/js/easiapiai.mjs\" hook send 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}
